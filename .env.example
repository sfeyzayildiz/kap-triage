# Copy to .env and fill in only what you need. .env is git-ignored: never commit it.
# The panel on made-up data (python main.py panel --sample) needs none of these.
# Every line below except KAP_TOKEN is commented out and shows the default the code uses.

# --- Matriks (licensed data; only the nightly collection needs these) ---
KAP_TOKEN=
# MATRIKS_NB_API=https://<MATRIKS_API_HOST>/dumrul      # new-business API base URL (from the vendor)
# MATRIKS_NEWS_API=https://<MATRIKS_API_HOST>/dumrul    # news API base URL (from the vendor)

# --- Data folder ---
# KAP_DATA_DIR=data          # "main.py panel --sample" points it to sample/data/ by itself

# --- Local model (Ollama) ---
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_HOST=http://127.0.0.1:11434    # Docker uses http://host.docker.internal:11434
# OLLAMA_THINK=              # unset = model default; true / false forces thinking
# LLM_TIMEOUT=120            # seconds per model call
# NUM_PREDICT=-1             # max generated tokens; -1 = no limit

# --- Nightly job ---
# NTFY_URL=                  # phone alert (counts only); unset = no alert
# LOCK_WAIT=300              # seconds between retries while the database is locked

# --- Panel ---
# PANEL_HOST=127.0.0.1       # keep 127.0.0.1 on a computer; Docker sets 0.0.0.0 inside the container

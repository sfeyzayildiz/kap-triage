<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.feyza.kap-daily</string>

    <!--
      Runs from a separate deploy clone (~/projects/kap-deploy) that always
      stays on main, so the dev folder's current branch never affects the
      nightly job. data/ and .env in the deploy clone are symlinks to
      ~/projects/kap-explore, so there is a single database.
      After merging a PR: git -C ~/projects/kap-deploy pull
    -->

    <!-- deploy venv python (same Python and packages as the dev venv) -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/YOUR_USERNAME/projects/kap-deploy/.venv/bin/python</string>
        <string>main.py</string>
        <string>nightly</string>
    </array>

    <!-- data/ and .env are relative to the repository root, so run from the deploy clone root -->
    <key>WorkingDirectory</key>
    <string>/Users/YOUR_USERNAME/projects/kap-deploy</string>

    <!-- every day at 23:43; if the Mac is asleep, runs on wake -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>43</integer>
    </dict>

    <!-- logs stay in the real data/ folder (gitignored) -->
    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/projects/kap-explore/data/daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/projects/kap-explore/data/daily.log</string>
</dict>
</plist>
